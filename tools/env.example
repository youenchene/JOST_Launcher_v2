# Copy to tools/env.local (gitignored) and set your own paths.
# Nothing here is in the repo: ROMs and Workbench are copyrighted.

# Amiga Game Kit CLI (https://github.com/codebase/amiga-game-kit), if not on
# PATH and not checked out next to this repo as ../amiga-game-kit
#AGK=~/src/amiga-game-kit/tools/agk

# Workbench 1.3 disk (test disks are built from it)
JL_WB13_ADF=~/Amiga/workbench133.adf
# A WHDLoad collection: GAMES/<letter>/<game>.lha (game names for the test
# inventory, real games for the demo)
JL_WHDLOAD=~/Amiga/WHDLOAD/GAMES
# jst 7.1 zip (https://github.com/jotd666/jst)
JL_JST_ZIP=~/Amiga/jst_7.1.zip
# Kickstart 1.3 ROM for FS-UAE and tools/ocr.py (default: the kit's roms/kick13.rom)
#JL_KICK13=~/Amiga/kick13.rom
# CDTV extended ROM (only for tools/mkdemo.py --cdtv)
#JL_CDTV_EXT=~/Amiga/cdtv-ext.rom
