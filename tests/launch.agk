# Fire launches (jst_command=memreport on the test disk: a C stand-in for jst;
# BCPL commands like 1.3's Echo can't be called without a shell), the launcher comes back
# with the same list and the same selection (v0.x lost it: it started a 2nd
# copy of itself on top of the first).
wait 2
press down 12
wait 5
press fire
wait-serial "returned=1" 3000
wait 5
screenshot back
expect-serial "ev=move mode=0 sel=3 [^\n]*\nAGK launch=3DConstructionKit.slave\n(AGK .*\n)*AGK returned=1"
expect-serial "returned=1\n(AGK .*\n)*AGK ev=start mode=0 sel=3 count=1200"
# the file was rewritten in name order on launch: the 2nd start skips the sort
expect-serial "resorted=1\n[\s\S]*returned=1\n[\s\S]*sorted=1"
# the game starts with the menu unloaded: only the stub stays resident
expect-serial "launch=3DConstructionKit.slave\n(AGK .*\n)*AGK chip=\d+ fast=\d+ .*mem=report"
